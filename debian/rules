#!/usr/bin/make -f

# Current upstream needs Vulkan headers >= 1.4.353 (for the VK_KHR_extended_flags and
# VK_EXT_multisampled_render_to_swapchain types, which it pulls in unconditionally), newer than the
# distro's libvulkan-dev. That floor is independent of the manifest's advertised api_version (1.4.356,
# the header version upstream validates against). CI and users can point the build at a newer
# Vulkan-Headers checkout via the VULKAN_CXX_INCLUDE environment variable, forwarded through debuild
# with "debuild -e VULKAN_CXX_INCLUDE". All backend/allocator options match the project's CMake
# defaults and are intentionally not repeated here.
ifneq ($(VULKAN_CXX_INCLUDE),)
VULKAN_HEADERS_ARG = -DVULKAN_CXX_INCLUDE=$(VULKAN_CXX_INCLUDE)
endif

%:
	dh $@ --builddirectory=build/

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release $(VULKAN_HEADERS_ARG)
